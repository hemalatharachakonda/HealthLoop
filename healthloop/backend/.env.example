# Get a free key at https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Database connection - defaults to SQLite (zero setup) if left unset.
# Uncomment ONE of the lines below to switch:

# SQLite (default, no setup needed - good for hackathon demo)
# DATABASE_URL=sqlite:///./healthloop.db

# PostgreSQL (local or free hosted via Supabase/Neon/Railway)
# DATABASE_URL=postgresql://username:password@localhost:5432/healthloop

# MySQL
# DATABASE_URL=mysql+pymysql://username:password@localhost:3306/healthloop

# Email for reminders + parent-notification alerts.
# On a deployed host (e.g. Render free tier), outbound SMTP is usually blocked -
# use BREVO_API_KEY or RESEND_API_KEY there. Locally, Gmail SMTP works fine too.

# Option A (recommended - works when deployed, sends to ANY recipient):
# Brevo, free at https://app.brevo.com - verify one sender email (Settings ->
# Senders & IP), no domain/DNS setup needed.
# BREVO_API_KEY=xkeysib-your_key_here
# BREVO_SENDER_EMAIL=the_email_you_verified_in_brevo@example.com

# Option B (works when deployed, but ONLY sends to your own Resend signup email
# unless you verify a full domain): Resend, free at https://resend.com
# RESEND_API_KEY=re_your_key_here
# RESEND_FROM=HealthLoop <onboarding@resend.dev>

# Option C (local dev only - Render blocks this): Gmail SMTP, needs an app
# password, not your real password
# EMAIL_ADDRESS=youraddress@gmail.com
# EMAIL_APP_PASSWORD=your_16_char_app_password
