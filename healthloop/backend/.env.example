# Get a free key at https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Database connection - defaults to SQLite (zero setup) if left unset.
# Uncomment ONE of the lines below to switch:

# SQLite (default, no setup needed - good for hackathon demo)
# DATABASE_URL=sqlite:///./healthloop.db

# PostgreSQL (local or free hosted via Supabase/Neon/Railway)
# DATABASE_URL=postgresql://username:password@localhost:5432/healthloop

# MySQL
# DATABASE_URL=mysql+pymysql://username:password@localhost:3306/healthloop

# Email for reminders + parent-notification alerts.
# On a deployed host (e.g. Render free tier), outbound SMTP is usually blocked -
# use RESEND_API_KEY there. Locally, Gmail SMTP works fine as a simpler fallback.

# Option A (works when deployed): Resend, free at https://resend.com, sends over HTTPS
# RESEND_API_KEY=re_your_key_here
# RESEND_FROM=HealthLoop <onboarding@resend.dev>

# Option B (local dev only): Gmail SMTP - needs an app password, not your real password
# EMAIL_ADDRESS=youraddress@gmail.com
# EMAIL_APP_PASSWORD=your_16_char_app_password
